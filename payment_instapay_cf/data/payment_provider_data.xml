<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- InstaPay has no test environment: the provider is always live. It is published once a
         receiving account is set. -->
    <record id="payment_provider_instapay_cf" model="payment.provider">
        <field name="name">InstaPay</field>
        <field name="code">instapay_cf</field>
        <field name="sequence">7</field>
        <field name="is_live">True</field>
        <field name="maximum_amount">70000</field>
        <field name="image_128" type="bytes" file="payment_instapay_cf/static/description/icon.png"/>
        <field name="module_id" ref="base.module_payment_instapay_cf"/>
        <field name="redirect_form_view_id" ref="payment.generic_redirect_form"/>
        <field name="inline_form_view_id" ref="payment_instapay_cf.inline_form"/>
        <field name="pending_msg" type="html">
            <p>Your order is reserved until your transfer is confirmed.</p>
        </field>
        <field name="done_msg" type="html">
            <p>Your transfer is confirmed. Thank you!</p>
        </field>
        <field name="cancel_msg" type="html">
            <p>This payment is cancelled.</p>
        </field>
    </record>

</odoo>
