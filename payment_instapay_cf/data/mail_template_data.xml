<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Emails to customers about their InstaPay payment. The body comes from the QWeb template
         payment_instapay_cf.email_body, rendered in the customer's language. They are sent without
         Odoo's email layout and deleted once sent, as they hold the link to the payment page. -->

    <record id="mail_template_instapay_instructions" model="mail.template">
        <field name="name">InstaPay: payment details</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="subject">{{ object.company_id.name }}: how to pay {{ object.reference }} with InstaPay</field>
        <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div><t t-out="object._instapay_cf_get_email_body('instructions')"/></div>
        </field>
    </record>

    <record id="mail_template_instapay_receipt_received" model="mail.template">
        <field name="name">InstaPay: receipt received</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="subject">{{ object.company_id.name }}: we received your receipt for {{ object.reference }}</field>
        <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div><t t-out="object._instapay_cf_get_email_body('received')"/></div>
        </field>
    </record>

    <record id="mail_template_instapay_rejected" model="mail.template">
        <field name="name">InstaPay: receipt rejected</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="subject">{{ object.company_id.name }}: we couldn't confirm your transfer for {{ object.reference }}</field>
        <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div><t t-out="object._instapay_cf_get_email_body('rejected')"/></div>
        </field>
    </record>

    <record id="mail_template_instapay_reminder" model="mail.template">
        <field name="name">InstaPay: reminder</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="subject">{{ object.company_id.name }}: your order {{ object.reference }} is waiting for your InstaPay transfer</field>
        <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div><t t-out="object._instapay_cf_get_email_body('reminder')"/></div>
        </field>
    </record>

    <record id="mail_template_instapay_confirmed" model="mail.template">
        <field name="name">InstaPay: payment confirmed</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="subject">{{ object.company_id.name }}: your payment {{ object.reference }} is confirmed</field>
        <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div><t t-out="object._instapay_cf_get_email_body('confirmed')"/></div>
        </field>
    </record>

    <record id="mail_template_instapay_cancelled" model="mail.template">
        <field name="name">InstaPay: payment cancelled</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="subject">{{ object.company_id.name }}: your InstaPay payment {{ object.reference }} is cancelled</field>
        <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div><t t-out="object._instapay_cf_get_email_body('cancelled')"/></div>
        </field>
    </record>

</odoo>
