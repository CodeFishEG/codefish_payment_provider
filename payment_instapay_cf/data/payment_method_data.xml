<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_method_instapay" model="payment.method">
        <field name="name">InstaPay</field>
        <field name="code">instapay</field>
        <field name="sequence">10</field>
        <field name="provider_id" ref="payment_instapay_cf.payment_provider_instapay_cf"/>
        <field name="image" type="bytes" file="payment_instapay_cf/static/img/instapay.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_manual_capture">none</field>
        <field name="support_refund">none</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.eg')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.EGP')])]"/>
    </record>

</odoo>
