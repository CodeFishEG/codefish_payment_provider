<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_instapay_account_form" model="ir.ui.view">
        <field name="name">payment.instapay.account.form</field>
        <field name="model">payment.instapay.account</field>
        <field name="arch" type="xml">
            <form string="Receiving Account">
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not warning">
                        <field name="warning" nolabel="1"/>
                    </div>
                    <field name="provider_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="kind" widget="radio" options="{'horizontal': true}"/>
                            <field name="name"/>
                            <field name="holder_name" placeholder="As InstaPay shows it to the payer"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="InstaPay Account" invisible="kind != 'instapay'">
                        <group>
                            <field name="payment_link" placeholder="https://ipn.eg/S/yourshop/instapay/AbC123"/>
                            <field name="mobile" placeholder="010 0000 0000"/>
                            <field name="ipa" placeholder="yourshop@instapay"/>
                            <div colspan="2" class="text-muted small">
                                In the InstaPay app, open your profile: share your payment link and
                                export your QR code, then paste the link and upload the QR code here.
                            </div>
                        </group>
                        <group>
                            <field name="qr_image" widget="image" options="{'size': [180, 180]}"/>
                        </group>
                    </group>
                    <group string="Mobile Wallet" invisible="kind != 'wallet'">
                        <group>
                            <field name="wallet_operator" required="kind == 'wallet'"/>
                            <field name="wallet_number" required="kind == 'wallet'" placeholder="010 0000 0000"/>
                        </group>
                    </group>
                    <group string="Bank Account" invisible="kind != 'bank'">
                        <group>
                            <field name="bank_name" required="kind == 'bank'"/>
                            <field name="account_number"/>
                            <field name="iban" placeholder="EG00 0000 0000 0000 0000 0000 0000 0"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="e.g. Business account of our company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
