<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The body of the InstaPay emails to customers. Sent without Odoo's email layout: customers
         only know the company. Rendered in the customer's language by
         payment.transaction._instapay_cf_get_email_body(kind). -->
    <template id="email_body">
        <t t-set="button_style" t-value="'display:inline-block;padding:10px 18px;border-radius:6px;background-color:#0E7490;color:#ffffff;text-decoration:none;font-weight:600;'"/>
        <div style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#1F2937;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;">
                <tr>
                    <td style="padding:16px 0;border-bottom:1px solid #E5E7EB;font-size:18px;font-weight:700;">
                        <t t-out="company.name"/>
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 0;">
                        <p style="margin:0 0 12px 0;">Hello <t t-out="partner_name"/>,</p>

                        <t t-if="kind in ('instructions', 'reminder')">
                            <p style="margin:0 0 12px 0;">
                                <img t-att-src="logo_url" alt="InstaPay" width="150" style="display:block;width:150px;height:auto;border:0;"/>
                            </p>
                            <p t-if="kind == 'instructions'" style="margin:0 0 12px 0;">
                                Thank you for your order <strong t-out="reference"/>. To pay it, send
                                <strong t-out="amount_display"/> with InstaPay to one of the accounts
                                below, then upload a screenshot of the receipt.
                            </p>
                            <p t-else="" style="margin:0 0 12px 0;">
                                Your order <strong t-out="reference"/> is still waiting for your
                                InstaPay transfer of <strong t-out="amount_display"/>.
                            </p>
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 12px 0;">
                                <tr t-foreach="accounts" t-as="account">
                                    <td style="padding:10px 12px;border:1px solid #E5E7EB;border-radius:6px;">
                                        <div style="font-weight:700;" t-out="account['title']"/>
                                        <div t-foreach="account['rows']" t-as="row">
                                            <span style="color:#6B7280;"><t t-out="row['label']"/>:</span>
                                            <span dir="ltr" style="font-weight:600;" t-out="row['display']"/>
                                        </div>
                                        <div t-if="account['link']">
                                            <a t-att-href="account['link']" style="color:#0E7490;">Open InstaPay on your phone</a>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                            <p style="margin:0 0 16px 0;color:#6B7280;">
                                If your app lets you add a note to the transfer, write
                                <strong t-out="reference"/>. Any InstaPay fee is paid by you, on top
                                of the amount.
                            </p>
                            <p style="margin:0 0 16px 0;">
                                <a t-att-href="pay_page_url" t-att-style="button_style">Upload your receipt</a>
                            </p>
                        </t>

                        <t t-elif="kind == 'received'">
                            <p style="margin:0 0 12px 0;">
                                We received the receipt of your InstaPay transfer for
                                <strong t-out="reference"/>.
                                <t t-if="review_date_text">
                                    <t t-out="company.name"/> will confirm your payment by
                                    <strong t-out="review_date_text"/>.
                                </t>
                                <t t-else="">
                                    <t t-out="company.name"/> will confirm your payment within
                                    <t t-out="review_days"/> working days.
                                </t>
                            </p>
                        </t>

                        <t t-elif="kind == 'rejected'">
                            <p style="margin:0 0 12px 0;">
                                We couldn't confirm your InstaPay transfer for
                                <strong t-out="reference"/><t t-if="rejection">:
                                <t t-out="rejection['reason']"/></t>.
                            </p>
                            <p t-if="rejection and rejection['message']" style="margin:0 0 12px 0;" t-out="rejection['message']"/>
                            <p style="margin:0 0 16px 0;">
                                <a t-att-href="pay_page_url" t-att-style="button_style">Send a new receipt</a>
                            </p>
                        </t>

                        <t t-elif="kind == 'confirmed'">
                            <p style="margin:0 0 12px 0;">
                                Your InstaPay transfer of <strong t-out="amount_display"/> for
                                <strong t-out="reference"/> is confirmed. Thank you!
                            </p>
                        </t>

                        <t t-elif="kind == 'cancelled'">
                            <p t-if="cancelled_by == 'expiry'" style="margin:0 0 12px 0;">
                                We received no receipt for the InstaPay payment <strong t-out="reference"/>,
                                so it was cancelled.
                            </p>
                            <p t-else="" style="margin:0 0 12px 0;">
                                <t t-out="company.name"/> cancelled the InstaPay payment
                                <strong t-out="reference"/>.
                            </p>
                            <p t-if="cancel_message" style="margin:0 0 12px 0;" t-out="cancel_message"/>
                            <p style="margin:0 0 16px 0;">
                                <a t-att-href="document_absolute_url" t-att-style="button_style">Pay again</a>
                            </p>
                        </t>
                    </td>
                </tr>
                <tr>
                    <td style="padding:12px 0;border-top:1px solid #E5E7EB;color:#6B7280;font-size:12px;">
                        <t t-out="company.name"/>
                        <t t-if="company.phone"> · <span dir="ltr" t-out="company.phone"/></t>
                        <t t-if="company.email"> · <t t-out="company.email"/></t>
                    </td>
                </tr>
            </table>
        </div>
    </template>

</odoo>
