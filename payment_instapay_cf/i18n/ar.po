#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/models/payment_instapay_account.py:0
msgid ""
"%(iban)s isn't a valid Egyptian IBAN (EG followed by 27 digits). Check it on"
" a bank document."
msgstr ""
"%(iban)s ليس رقم IBAN مصريًا صحيحًا (EG متبوعًا بـ 27 رقمًا). راجعه في أحد "
"مستندات البنك."

#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/models/payment_transaction.py:0
msgid ""
"%(invoices)s is already paid. Confirming would record a second payment."
msgstr "%(invoices)s مدفوعة بالفعل. التأكيد سيسجّل دفعة ثانية."

#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/models/payment_instapay_account.py:0
msgid "%(ipa)s isn't an InstaPay address. It looks like yourshop@instapay."
msgstr "%(ipa)s ليس عنوان إنستاباي. يكون العنوان بصيغة yourshop@instapay."

#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/models/payment_instapay_account.py:0
msgid ""
"%(number)s isn't an Egyptian mobile number (11 digits starting with 010, "
"011, 012 or 015)."
msgstr ""
"%(number)s ليس رقم هاتف محمول مصريًا (11 رقمًا تبدأ بـ 010 أو 011 أو 012 أو "
"015)."

#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/models/payment_transaction.py:0
msgid ""
"%(orders)s is already paid by %(payments)s. Confirming would record a second"
" payment."
msgstr ""
"%(orders)s مدفوع بالفعل بواسطة %(payments)s. التأكيد سيسجّل دفعة ثانية."

#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/wizard/payment_instapay_review_wizard.py:0
msgid "%(receipt)s: added by a staff member, not by the customer."
msgstr "%(receipt)s: أضافه موظف، وليس العميل."

#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/wizard/payment_instapay_review_wizard.py:0
msgid "%(receipt)s: the amount sent differs from the amount to pay."
msgstr "%(receipt)s: المبلغ المرسل يختلف عن المبلغ المطلوب."

#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/wizard/payment_instapay_review_wizard.py:0
msgid ""
"%(receipt)s: the same screenshot or reference was sent for another payment "
"(%(others)s)."
msgstr ""
"%(receipt)s: أُرسلت لقطة الشاشة نفسها أو المرجع نفسه لدفعة أخرى "
"(%(others)s)."

#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/wizard/payment_instapay_review_wizard.py:0
msgid "%(receipt)s: the transfer is dated before the order."
msgstr "%(receipt)s: تاريخ التحويل سابق للطلب."

#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/wizard/payment_instapay_review_wizard.py:0
msgid "%(receipt)s: the transfer is dated in the future."
msgstr "%(receipt)s: تاريخ التحويل في المستقبل."

#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/wizard/payment_instapay_review_wizard.py:0
msgid ""
"%(received)s were received but %(expected)s are due. Reject the receipt with"
" the reason \"Amount lower than expected\" instead, so the customer sends "
"the rest."
msgstr ""
"تم استلام %(received)s بينما المستحق %(expected)s. بدلًا من ذلك، ارفض "
"الإيصال بالسبب \"المبلغ أقل من المطلوب\" ليرسل العميل باقي المبلغ."

#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/wizard/payment_instapay_review_wizard.py:0
msgid "%(user)s cancelled the InstaPay payment."
msgstr "ألغى %(user)s دفعة إنستاباي."

#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/wizard/payment_instapay_review_wizard.py:0
msgid ""
"%(user)s found the InstaPay transfer of %(amount)s in %(account)s and "
"confirmed the payment."
msgstr ""
"وجد %(user)s تحويل إنستاباي بمبلغ %(amount)s في %(account)s وأكّد الدفعة."

#. module: payment_instapay_cf
#. odoo-python
#: code:addons/payment_instapay_cf/wizard/payment_instapay_review_wizard.py:0
msgid "%(user)s rejected the InstaPay receipt: %(reason)s."
msgstr "رفض %(user)s إيصال إنستاباي: %(reason)s."

