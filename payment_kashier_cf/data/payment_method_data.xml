<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Kashier's payment methods, one per method of Kashier's page. Each reaches Kashier as set in its
         "Integration" (Kashier's page, embedded page, server side, Apple Pay button); the methods the merchant
         account doesn't accept are hidden at checkout. `kashier` offers every method of the account at once and
         is not activated at installation. -->

    <record id="payment_method_card" model="payment.method">
        <field name="name">Card</field>
        <field name="code">card</field>
        <field name="sequence">10</field>
        <field name="provider_id" ref="payment_kashier_cf.payment_provider_kashier_cf"/>
        <field name="image" type="bytes" file="payment/static/img/card.png"/>
        <field name="support_tokenization">True</field>
        <field name="support_manual_capture">full_only</field>
        <field name="support_refund">partial</field>
        <field name="kashier_cf_integration">redirect</field>
    </record>

    <record id="payment_method_kashier" model="payment.method">
        <field name="name">Kashier</field>
        <field name="code">kashier</field>
        <field name="sequence">90</field>
        <field name="provider_id" ref="payment_kashier_cf.payment_provider_kashier_cf"/>
        <field name="image" type="bytes" file="payment_kashier_cf/static/img/kashier.png"/>
        <field name="support_refund">partial</field>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.EGP'), ref('base.USD'), ref('base.GBP'), ref('base.EUR')])]"/>
        <field name="kashier_cf_integration">redirect</field>
    </record>

