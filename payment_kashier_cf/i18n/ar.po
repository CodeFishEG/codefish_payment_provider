#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_transaction__kashier_cf_alerted
msgid "Kashier Alerts Sent"
msgstr "تنبيهات كاشير المُرسَلة"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_token__kashier_cf_expiry
msgid "Kashier Card Expiry"
msgstr "تاريخ انتهاء البطاقة لدى كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_token__kashier_cf_customer_reference
msgid "Kashier Customer"
msgstr "العميل لدى كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_transaction__kashier_cf_error_code
msgid "Kashier Error Code"
msgstr "كود خطأ كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_transaction__kashier_cf_error_details
msgid "Kashier Error Details"
msgstr "تفاصيل خطأ كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_transaction__kashier_cf_late_check_until
msgid "Kashier Late Check Until"
msgstr "متابعة الدفع المتأخر لدى كاشير حتى"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_token__kashier_cf_is_live
msgid "Kashier Live Card"
msgstr "بطاقة الوضع المباشر لدى كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_provider__kashier_cf_merchant_id
msgid "Kashier Merchant ID"
msgstr "معرف التاجر لدى كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_provider__kashier_cf_allowed_methods
msgid "Kashier Methods"
msgstr "وسائل الدفع لدى كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_provider__kashier_cf_webhook_url
msgid "Kashier Notification URL"
msgstr "رابط إشعارات كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_transaction__kashier_cf_operation
msgid "Kashier Operation"
msgstr "العملية لدى كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_transaction__kashier_cf_order_ref
msgid "Kashier Order"
msgstr "الطلب لدى كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_transaction__kashier_cf_order_id
msgid "Kashier Order ID"
msgstr "معرف الطلب لدى كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_transaction__kashier_cf_outcome_unknown
msgid "Kashier Outcome Unknown"
msgstr "نتيجة كاشير غير معروفة"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_transaction__kashier_cf_redirect_url
msgid "Kashier Page URL"
msgstr "رابط صفحة الدفع لدى كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_provider__kashier_cf_payment_api_key
msgid "Kashier Payment API Key"
msgstr "مفتاح Payment API لدى كاشير"

#. module: payment_kashier_cf
#: model:ir.module.module,shortdesc:base.module_payment_kashier_cf
msgid "Kashier Payments"
msgstr "مدفوعات كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_transaction__kashier_cf_noted_legs
msgid "Kashier Refunds Noted"
msgstr "استردادات كاشير المُدوَّنة"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_provider__kashier_cf_secret_key
msgid "Kashier Secret Key"
msgstr "المفتاح السري لدى كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_transaction__kashier_cf_session_id
msgid "Kashier Session"
msgstr "جلسة الدفع لدى كاشير"

#. module: payment_kashier_cf
#: model:ir.model.fields,field_description:payment_kashier_cf.field_payment_transaction__kashier_cf_transaction_id
msgid "Kashier Transaction"
msgstr "المعاملة لدى كاشير"

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/models/payment_provider.py:0
msgid ""
"Kashier accepted the Secret Key and the Payment API Key (%(mode)s mode)."
msgstr "قبل كاشير المفتاح السري ومفتاح Payment API (الوضع: %(mode)s)."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/const.py:0
msgid "Kashier already has an order with this reference."
msgstr "لدى كاشير طلب بهذا المرجع بالفعل."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/const.py:0
msgid "Kashier answered too late. The outcome is checked with Kashier."
msgstr "تأخر رد كاشير. جارٍ التحقق من النتيجة لدى كاشير."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/const.py:0
msgid "Kashier asked to slow down. The request is checked again later."
msgstr "طلب كاشير تخفيف معدل الطلبات. سيُعاد التحقق من الطلب لاحقًا."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/models/payment_transaction.py:0
msgid ""
"Kashier charged the saved card after this payment was marked failed. "
"Register the payment of %(amount)s by hand."
msgstr ""
"خصم كاشير المبلغ من البطاقة المحفوظة بعد اعتبار هذه الدفعة فاشلة. سجّل دفعة "
"بمبلغ %(amount)s يدويًا."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/models/payment_transaction.py:0
msgid "Kashier confirmed a late payment of this transaction."
msgstr "أكّد كاشير دفعة متأخرة لهذه المعاملة."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/models/payment_transaction.py:0
msgid ""
"Kashier confirmed a payment whose amount or currency differs from this "
"payment. Check the order in Kashier's dashboard."
msgstr ""
"أكّد كاشير دفعة يختلف مبلغها أو عملتها عن هذه الدفعة. راجع الطلب في لوحة "
"تحكم كاشير."

#. module: payment_kashier_cf
#: model:ir.model.fields,help:payment_kashier_cf.field_payment_provider__kashier_cf_payment_api_key
msgid ""
"Kashier dashboard: Integrate now > Payment API keys. Test and live modes "
"have different keys. It also signs Kashier's notifications."
msgstr ""
"لوحة تحكم كاشير: Integrate now > Payment API keys. للوضعين التجريبي والمباشر"
" مفاتيح مختلفة. ويُستخدم أيضًا لتوقيع إشعارات كاشير."

#. module: payment_kashier_cf
#: model:ir.model.fields,help:payment_kashier_cf.field_payment_provider__kashier_cf_secret_key
msgid ""
"Kashier dashboard: Integrate now > Secret key. Test and live modes have "
"different keys. It confirms payments, refunds and captures; the dashboard "
"user it belongs to needs the refund permission for refunds."
msgstr ""
"لوحة تحكم كاشير: Integrate now > Secret key. للوضعين التجريبي والمباشر "
"مفاتيح مختلفة. يُستخدم لتأكيد المدفوعات وعمليات الاسترداد والتحصيل؛ ويحتاج "
"مستخدم لوحة التحكم صاحب هذا المفتاح إلى صلاحية الاسترداد لإجراء عمليات "
"الاسترداد."

#. module: payment_kashier_cf
#: model:ir.model.fields,help:payment_kashier_cf.field_payment_provider__kashier_cf_merchant_id
msgid "Kashier dashboard: shown under your name (MID-xxx-xxx)."
msgstr "لوحة تحكم كاشير: يظهر أسفل اسمك (MID-xxx-xxx)."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/models/payment_provider.py:0
msgid ""
"Kashier didn't answer in time. The request may still have been processed: it"
" is checked with Kashier before anything is sent again."
msgstr ""
"لم يرد كاشير في الوقت المحدد. ربما تمت معالجة الطلب رغم ذلك: سيتم التحقق منه"
" لدى كاشير قبل إرسال أي شيء مرة أخرى."

#. module: payment_kashier_cf
#: model:ir.model.fields,help:payment_kashier_cf.field_payment_transaction__kashier_cf_outcome_unknown
msgid ""
"Kashier didn't answer the request: the outcome is checked with Kashier "
"before anything is sent again."
msgstr ""
"لم يرد كاشير على الطلب: يجري التحقق من النتيجة لدى كاشير قبل إرسال أي شيء "
"مرة أخرى."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/models/payment_transaction.py:0
msgid "Kashier didn't answer. Try again in a moment."
msgstr "لم يرد كاشير. حاول مرة أخرى بعد قليل."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/models/payment_transaction.py:0
msgid ""
"Kashier didn't confirm this operation. Check it in Kashier's dashboard "
"before trying again."
msgstr ""
"لم يؤكد كاشير هذه العملية. راجعها في لوحة تحكم كاشير قبل المحاولة مرة أخرى."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/const.py:0
msgid "Kashier doesn't know this payment."
msgstr "لا يعرف كاشير هذه الدفعة."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/const.py:0
msgid "Kashier had an error. The outcome is checked with Kashier."
msgstr "حدث خطأ لدى كاشير. جارٍ التحقق من النتيجة لدى كاشير."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/models/payment_transaction.py:0
msgid ""
"Kashier has several paid orders for this payment: %(orders)s. Refund the "
"extra ones."
msgstr ""
"لدى كاشير عدة طلبات مدفوعة لهذه الدفعة: %(orders)s. ردّ مبالغ الطلبات "
"الزائدة."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/models/payment_transaction.py:0
msgid "Kashier hasn't confirmed this payment yet: check its status first."
msgstr "لم يؤكد كاشير هذه الدفعة بعد: تحقق من حالتها أولًا."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/models/payment_transaction.py:0
msgid ""
"Kashier hasn't decided the outcome of this payment. Check the order in "
"Kashier's dashboard before asking the customer to pay again."
msgstr ""
"لم يحسم كاشير نتيجة هذه الدفعة بعد. راجع الطلب في لوحة تحكم كاشير قبل أن "
"تطلب من العميل الدفع مرة أخرى."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/models/payment_transaction.py:0
msgid ""
"Kashier refunded %(amount)s of this payment outside Odoo (Kashier "
"transaction %(tx)s). Record the refund in Odoo if it isn't yet."
msgstr ""
"ردّ كاشير مبلغ %(amount)s من هذه الدفعة خارج Odoo (معاملة كاشير %(tx)s). "
"سجّل الاسترداد في Odoo إن لم يكن مسجّلًا بعد."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/const.py:0
msgid ""
"Kashier refused the credentials. Check the Secret Key, the Payment API Key "
"and the Merchant ID, and that they are for the right mode (test or live)."
msgstr ""
"رفض كاشير بيانات الاعتماد. راجع المفتاح السري ومفتاح Payment API ومعرف "
"التاجر، وتأكد من أنها تخص الوضع الصحيح (تجريبي أو مباشر)."

#. module: payment_kashier_cf
#. odoo-python
#: code:addons/payment_kashier_cf/const.py:0
msgid ""
"Kashier refused the request signature. Check the Payment API Key and the "
"Merchant ID."
