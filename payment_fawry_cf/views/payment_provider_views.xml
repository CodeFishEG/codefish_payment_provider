<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Fawry Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    string="Test Connection"
                    help="Check the merchant code and the secure key with Fawry."
                    type="object"
                    name="action_fawry_test_connection"
                    invisible="code != 'fawry'"
                    class="btn-secondary"
                />
            </header>
            <group name="provider_credentials" position="inside">
                <field
                    string="Merchant Code"
                    name="fawry_merchant_code"
                    invisible="code != 'fawry'"
                    required="is_live and code == 'fawry'"
                />
                <field
                    string="Secure Key"
                    name="fawry_secure_key"
                    invisible="code != 'fawry'"
                    required="is_live and code == 'fawry'"
                    widget="password"
                />
            </group>
            <group name="provider_credentials" position="after">
                <group string="Fawry" name="fawry_options" invisible="code != 'fawry'">
                    <field
                        name="fawry_integration"
                        widget="radio"
                        required="code == 'fawry'"
                    />
                    <div colspan="2" class="text-muted small mb-2" invisible="fawry_integration != 'express'">
                        Every method is paid on FawryPay's secure checkout. Cards can't be saved.
                    </div>
                    <div colspan="2" class="text-muted small mb-2" invisible="fawry_integration != 's2s'">
                        Cards are saved on Fawry's secure card page and charged with 3-D Secure.
                        Reference codes, wallets and myFawry are created by Odoo and shown on your
                        website. valU, Forsa, Souhoola and FawryPay use the hosted checkout.
                    </div>
                    <field name="fawry_display_mode" required="code == 'fawry'"/>
                    <label for="fawry_payment_expiry_hours"/>
                    <div class="o_row">
                        <field name="fawry_payment_expiry_hours" class="oe_inline"/>
                        <span>hours</span>
                    </div>
                    <field name="fawry_webhook_url" widget="CopyClipboardChar"/>
                    <field name="fawry_bank_installments" invisible="fawry_integration != 's2s'"/>
                    <div colspan="2" class="text-muted small mb-2" invisible="fawry_integration != 's2s' or not fawry_bank_installments">
                        After entering their card, customers choose to pay in full or with an
                        installment plan of their bank. Fawry activates the plans on your account.
                        <button
                            string="Show Installment Plans"
                            help="Show the installment plans that Fawry activated on your account."
                            type="object"
                            name="action_fawry_show_installment_plans"
                            class="btn-link p-0 align-baseline"
                        />
                    </div>
                    <field name="fawry_payment_split"/>
                    <div colspan="2" class="text-muted small mb-2" invisible="not fawry_payment_split">
                        Set the sub-accounts and their shares in the Payment Split tab.
                    </div>
                </group>
            </group>
            <notebook position="inside">
                <page string="Payment Split" name="fawry_payment_split" invisible="code != 'fawry' or not fawry_payment_split">
                    <div class="text-muted mb-3">
                        Create the sub-accounts in Fawry's dashboard (My Accounts &gt; Payment
                        Splitting), then add them here with their share. For each item paid, every
                        sub-account that applies to it receives its share of the item's price;
                        Fawry pays the rest to your own account. Fawry pays each sub-account to its
                        own bank account.
                    </div>
                    <field name="fawry_split_account_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="share"/>
                            <field name="apply_to"/>
                            <field
                                name="product_tmpl_ids"
                                widget="many2many_tags"
                                invisible="apply_to != 'products'"
                                required="apply_to == 'products'"
                            />
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </notebook>
            <field name="available_currency_ids" position="attributes">
                <attribute name="readonly" separator=" or " add="code == 'fawry'"/>
            </field>
        </field>
    </record>

</odoo>
