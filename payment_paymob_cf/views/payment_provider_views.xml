<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Paymob Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    string="Test Connection"
                    help="Check the API key with Paymob and count the integrations of the account in this mode (test or live)."
                    type="object"
                    name="action_paymob_cf_test_connection"
                    invisible="code != 'paymob_cf'"
                    class="btn-secondary"
                />
                <button
                    string="Sync Integrations"
                    help="Fill the integration IDs of the payment methods from your Paymob account. Nothing is changed at Paymob."
                    type="object"
                    name="action_paymob_cf_sync_integrations"
                    invisible="code != 'paymob_cf'"
                    class="btn-secondary"
                />
            </header>
            <group name="provider_credentials" position="inside">
                <field
                    name="paymob_cf_country"
                    invisible="code != 'paymob_cf'"
                    required="code == 'paymob_cf'"
                />
                <field
                    name="paymob_cf_secret_key"
                    invisible="code != 'paymob_cf'"
                    required="is_live and code == 'paymob_cf'"
                    widget="password"
                />
                <field
                    name="paymob_cf_public_key"
                    invisible="code != 'paymob_cf'"
                    required="is_live and code == 'paymob_cf'"
                />
                <field
                    name="paymob_cf_api_key"
                    invisible="code != 'paymob_cf'"
                    required="is_live and code == 'paymob_cf'"
                    widget="password"
                />
                <field
                    name="paymob_cf_hmac_secret"
                    invisible="code != 'paymob_cf'"
                    required="is_live and code == 'paymob_cf'"
                    widget="password"
                />
            </group>
            <group name="provider_credentials" position="after">
                <group string="Paymob" name="paymob_cf_options" invisible="code != 'paymob_cf'">
                    <field
                        name="paymob_cf_integration"
                        widget="radio"
                        required="code == 'paymob_cf'"
                    />
                    <div colspan="2" class="text-muted small mb-2" invisible="paymob_cf_integration != 'hosted'">
                        Every method is paid on Paymob's secure checkout. Cards can't be saved.
                    </div>
                    <div colspan="2" class="text-muted small mb-2" invisible="paymob_cf_integration != 'embedded'">
                        Cards are entered in Paymob's secure card form, embedded in your website.
                        They can be saved, captured manually and charged again. Wallets, kiosk and
                        installments use Paymob's checkout.
                    </div>
                    <field name="paymob_cf_display_mode" required="code == 'paymob_cf'"/>
                    <label for="paymob_cf_payment_expiry_hours"/>
                    <div class="o_row">
                        <field name="paymob_cf_payment_expiry_hours" class="oe_inline"/>
                        <span>hours</span>
                    </div>
                    <field name="paymob_cf_webhook_url" widget="CopyClipboardChar"/>
                    <field name="paymob_cf_auth_integration_id" options="{'enable_formatting': false}" invisible="not capture_manually and not paymob_cf_auth_integration_id"/>
                    <field name="paymob_cf_moto_integration_id" options="{'enable_formatting': false}" invisible="paymob_cf_integration != 'embedded'"/>
                    <field name="paymob_cf_verification_integration_id" options="{'enable_formatting': false}" invisible="paymob_cf_integration != 'embedded'"/>
                    <field name="paymob_cf_payment_split"/>
                    <div colspan="2" class="text-muted small mb-2" invisible="not paymob_cf_payment_split">
                        Add the merchants connected to your Paymob account, and their shares, in the
                        Payment Split tab.
                    </div>
                </group>
            </group>
            <xpath expr="//field[@name='primary_payment_method_ids']/list/field[@name='active']" position="after">
                <field
                    name="paymob_cf_integration_id"
                    string="Integration ID"
                    options="{'enable_formatting': false}"
                    column_invisible="parent.code != 'paymob_cf'"
                    width="120"
                />
            </xpath>
            <notebook position="inside">
                <page string="Payment Split" name="paymob_cf_payment_split" invisible="code != 'paymob_cf' or not paymob_cf_payment_split">
                    <div class="text-muted mb-3">
                        Ask Paymob to connect the merchants to your account and to enable split
                        amounts, then add them here with their share. For each item paid, every
                        merchant that applies to it receives its share of the item's price; the
                        rest is yours. Paymob pays each merchant its share.
                    </div>
                    <field name="paymob_cf_split_merchant_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="mid"/>
                            <field name="share"/>
                            <field name="apply_to"/>
                            <field
                                name="product_tmpl_ids"
                                widget="many2many_tags"
                                invisible="apply_to != 'products'"
                                required="apply_to == 'products'"
                            />
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
                <page string="Apple Pay" name="paymob_cf_apple_pay" invisible="code != 'paymob_cf' or paymob_cf_country == 'PK'">
                    <div class="text-muted mb-3">
                        Customers using Safari on an iPhone, iPad or Mac pay with Apple Pay and
                        confirm with Face ID, Touch ID or their passcode; other customers don't see
                        it. Paymob offers Apple Pay in Egypt, Saudi Arabia, the United Arab Emirates
                        and Oman, with live integrations only: it can't be tested in test mode.
                    </div>
                    <div invisible="paymob_cf_integration != 'hosted'">
                        <h5>With Paymob Checkout</h5>
                        <ol class="o_paymob_cf_steps">
                            <li>Ask Paymob (your account manager, or support@paymob.com) to enable
                                Apple Pay on your live account.</li>
                            <li>Tick <b>Live</b>, enter your live keys and save.</li>
                            <li>Click <b>Activate Apple Pay</b>. Odoo finds the Apple Pay integration
                                of your account, enters its ID on the Apple Pay payment method and
                                turns the method on.</li>
                        </ol>
                        <p class="text-muted">
                            Paymob shows Apple Pay on its own secure checkout, in a full page:
                            nothing to set up with Apple.
                        </p>
                    </div>
                    <div invisible="paymob_cf_integration != 'embedded'">
                        <h5>With the embedded checkout</h5>
                        <p class="text-muted">
                            The Apple Pay button is shown on your website, so Apple must know that
                            your website is yours, and Paymob needs your Apple Pay certificates.
                            You need a membership of the Apple Developer Program.
                        </p>
                        <ol class="o_paymob_cf_steps">
                            <li>Ask Paymob (your account manager, or support@paymob.com) to enable
                                Apple Pay on your live account.</li>
                            <li>Tick <b>Live</b>, enter your live keys and save.</li>
                            <li>On
                                <a href="https://developer.apple.com/account/resources/identifiers/list/merchant" target="_blank" rel="noopener">Apple's developer website</a>,
                                open <b>Certificates, Identifiers &amp; Profiles › Identifiers ›
                                Merchant IDs</b>, and create a Merchant ID (for example
                                merchant.com.yourshop) or open yours.</li>
                            <li>Under <b>Merchant Domains</b>, click <b>Add Domain</b> and enter your
                                website's domain without https:// or www (for example
                                shop.example.com). Download the file Apple gives,
                                apple-developer-merchantid-domain-association, without renaming it,
                                upload it below and save. Open the link below: it must show a long
                                line of text.</li>
                            <li>Back on Apple's page, click <b>Verify</b>. Your domain appears under
                                <b>Registered Domains</b>.</li>
                            <li>Create the two Apple Pay certificates of your Merchant ID (Merchant
                                Identity and Payment Processing) as
                                <a href="https://developers.paymob.com/paymob-docs/need-help/setup-guides/apple-pay-setup/apple-pay-certificates-creation" target="_blank" rel="noopener">Paymob explains</a>.
                                Put the six files in a password-protected zip, email it to
                                support@paymob.com and send the password another way (SMS or
                                WhatsApp).</li>
                            <li>Click <b>Activate Apple Pay</b>.</li>
                        </ol>
                        <group>
                            <field
                                name="paymob_cf_apple_pay_domain_file"
                                filename="paymob_cf_apple_pay_domain_filename"
                            />
                            <field name="paymob_cf_apple_pay_domain_filename" invisible="1"/>
                            <field name="paymob_cf_apple_pay_domain_url" widget="url"/>
                        </group>
                    </div>
                    <button
                        string="Activate Apple Pay"
                        help="Check what Apple Pay needs, then turn on the Apple Pay payment method."
                        type="object"
                        name="action_paymob_cf_activate_apple_pay"
                        class="btn-primary"
                    />
                </page>
                <page string="Test Data" name="paymob_cf_test_data" invisible="code != 'paymob_cf' or is_live">
                    <div class="text-muted mb-3">
                        For test payments, with the test keys and the test integration IDs of your
                        Paymob account. Paymob's published test data:
                    </div>
                    <table class="table table-sm o_paymob_cf_test_data">
                        <thead>
                            <tr><th>To test</th><th>Use</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Mastercard</td><td>5123 4567 8901 2346, expiry 01/39, CVV 123, name Test Account</td></tr>
                            <tr><td>Mastercard</td><td>5123 4500 0000 0008, expiry 01/39, CVV 123, name Test Account</td></tr>
                            <tr><td>Visa</td><td>4111 1111 1111 1111, expiry 01/39, CVV 123, name Test Account</td></tr>
                            <tr><td>Mobile wallet</td><td>Number 01010101010 (type 1010101010 after +20), MPIN 123456, OTP 123456</td></tr>
                            <tr><td>Kiosk, installments</td><td>Paymob has no simulator: test them with small live payments.</td></tr>
                        </tbody>
                    </table>
                    <div class="text-muted">
                        To see what Paymob sends, set
                        <a href="https://hooks.paymob.com" target="_blank" rel="noopener">Paymob's webhook tester</a>
                        as the callback of a test integration. To check an HMAC by hand, use
                        <a href="https://wizard.paymob.com" target="_blank" rel="noopener">Paymob's integration wizard</a>.
                        Apple Pay, Google Pay and bank installments only work with live integrations.
                    </div>
                </page>
            </notebook>
            <field name="available_currency_ids" position="attributes">
                <attribute name="readonly" separator=" or " add="code == 'paymob_cf'"/>
            </field>
        </field>
    </record>

    <record id="payment_method_form" model="ir.ui.view">
        <field name="name">Paymob Payment Method Form</field>
        <field name="model">payment.method</field>
        <field name="inherit_id" ref="payment.payment_method_form"/>
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="paymob_cf_provider_code" invisible="1"/>
                <field
                    name="paymob_cf_integration_id"
                    options="{'enable_formatting': false}"
                    invisible="paymob_cf_provider_code != 'paymob_cf' or not is_primary or code == 'paymob'"
                />
            </field>
        </field>
    </record>

</odoo>
